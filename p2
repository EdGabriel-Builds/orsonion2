Write-Host "[2/3] Configuring User Rights Assignment..." -ForegroundColor Green

try {
    secedit /export /cfg c:\secpol_rights.cfg | Out-Null
    
    $content = Get-Content c:\secpol_rights.cfg
    
    $content = $content -replace "SeNetworkLogonRight = .*", "SeNetworkLogonRight = *S-1-5-32-544"
    $content = $content -replace "SeInteractiveLogonRight = .*", "SeInteractiveLogonRight = *S-1-5-32-544,*S-1-5-32-545"
    $content = $content -replace "SeBackupPrivilege = .*", "SeBackupPrivilege = *S-1-5-32-544"
    $content = $content -replace "SeDenyNetworkLogonRight = .*", "SeDenyNetworkLogonRight = *S-1-5-32-546,*S-1-5-113"
    $content = $content -replace "SeDenyBatchLogonRight = .*", "SeDenyBatchLogonRight = *S-1-5-32-546"
    $content = $content -replace "SeDenyServiceLogonRight = .*", "SeDenyServiceLogonRight = *S-1-5-32-546"
    $content = $content -replace "SeDenyInteractiveLogonRight = .*", "SeDenyInteractiveLogonRight = *S-1-5-32-546"
    $content = $content -replace "SeDenyRemoteInteractiveLogonRight = .*", "SeDenyRemoteInteractiveLogonRight = *S-1-5-32-546,*S-1-5-113"
    $content = $content -replace "SeBatchLogonRight = .*", "SeBatchLogonRight = *S-1-5-32-544"
    $content = $content -replace "SeServiceLogonRight = .*", "SeServiceLogonRight = "
    $content = $content -replace "SeShutdownPrivilege = .*", "SeShutdownPrivilege = *S-1-5-32-544,*S-1-5-32-545"
    
    $content | Set-Content c:\secpol_rights.cfg
    
    secedit /configure /db c:\windows\security\local.sdb /cfg c:\secpol_rights.cfg /areas USER_RIGHTS | Out-Null
    
    Remove-Item -force c:\secpol_rights.cfg -confirm:$false
    
    Write-Host "  ✓ User Rights Assignment configured" -ForegroundColor White
    Write-Host ""
} catch {
    Write-Host "  ✗ ERROR configuring User Rights Assignment: $_" -ForegroundColor Red
    Write-Host ""
}

