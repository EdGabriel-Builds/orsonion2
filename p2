# Set (or add) Key<Sep>Value inside [Section] of an INF-style secedit config.
function Set-InfValue {
    param(
        [System.Collections.Generic.List[string]]$Lines,
        [string]$Section,
        [string]$Key,
        [string]$Value,
        [string]$Sep = ' = '
    )
    $start = -1
    for ($i = 0; $i -lt $Lines.Count; $i++) {
        if ($Lines[$i].Trim() -ieq "[$Section]") { $start = $i; break }
    }
    if ($start -lt 0) { $Lines.Add("[$Section]"); $start = $Lines.Count - 1 }

    $end = $Lines.Count
    for ($i = $start + 1; $i -lt $Lines.Count; $i++) {
        if ($Lines[$i].Trim().StartsWith('[')) { $end = $i; break }
    }

    $newLine = "$Key$Sep$Value"
    for ($i = $start + 1; $i -lt $end; $i++) {
        $k = ($Lines[$i] -split '=', 2)[0].Trim()
        if ($k -ieq $Key) { $Lines[$i] = $newLine; return }
    }
    $Lines.Insert($end, $newLine)   # key wasn't in the export: add it
}

# Export -> edit -> re-import one secedit area, with real error checking.
function Invoke-SeceditArea {
    param([string]$Area, [scriptblock]$Edit)

    $cfg = Join-Path $env:TEMP "secpol_$Area.cfg"
    $db  = Join-Path $env:windir 'security\local.sdb'
    try {
        & secedit.exe /export /cfg $cfg /areas $Area | Out-Null
        if ($LASTEXITCODE -ne 0) { throw "secedit /export failed (exit $LASTEXITCODE)" }

        $lines = [System.Collections.Generic.List[string]]::new([string[]](Get-Content -Path $cfg))
        & $Edit $lines

        # secedit requires UTF-16; Set-Content's default in PS 5.1 is ANSI.
        Set-Content -Path $cfg -Value $lines -Encoding Unicode

        & secedit.exe /configure /db $db /cfg $cfg /areas $Area /quiet | Out-Null
        if ($LASTEXITCODE -ne 0) { throw "secedit /configure failed (exit $LASTEXITCODE); see %windir%\security\logs\scesrv.log" }
    }
    finally {
        Remove-Item -Path $cfg -Force -ErrorAction SilentlyContinue
    }
}

# ---------------------------------------------------------------------------
# [1/3] Firewall rules
# ---------------------------------------------------------------------------
Write-Host "[1/3] Configuring Firewall Rules..." -ForegroundColor Green

function Add-BlockRule {
    param([string]$Name, [string]$Program)
    $exe = Split-Path $Program -Leaf
    foreach ($dir in 'Outbound', 'Inbound') {
        $display = "$Name - $exe ($dir)"
        Get-NetFirewallRule -DisplayName $display -ErrorAction SilentlyContinue | Remove-NetFirewallRule   # idempotent
        New-NetFirewallRule -DisplayName $display -Direction $dir -Program $Program -Action Block | Out-Null
    }
}

try {
    # Classic Win32 program: Edge
    $edgePaths = @(
        "${env:ProgramFiles(x86)}\Microsoft\Edge\Application\msedge.exe",
        "$env:ProgramFiles\Microsoft\Edge\Application\msedge.exe"
    ) | Where-Object { Test-Path $_ }
    if (-not $edgePaths) { Write-Host "  - Edge not found, skipped" -ForegroundColor Yellow }
    foreach ($p in $edgePaths) { Add-BlockRule -Name 'Block MS Edge' -Program $p }

    # Store/system apps: resolve real install folders (they are versioned, so hard-coded paths miss)
    $appx = [ordered]@{
        'Block Search'           = 'Microsoft.Windows.Search'
        'Block MSN Money'        = 'Microsoft.BingFinance'
        'Block MSN Sports'       = 'Microsoft.BingSports'
        'Block MSN News'         = 'Microsoft.BingNews'
        'Block MSN Weather'      = 'Microsoft.BingWeather'
        'Block Microsoft Photos' = 'Microsoft.Windows.Photos'
        'Block Xbox'             = 'Microsoft.Xbox*'
    }
    foreach ($label in $appx.Keys) {
        $pkgs = Get-AppxPackage -AllUsers -Name $appx[$label] -ErrorAction SilentlyContinue
        if (-not $pkgs) { Write-Host "  - $label : package not installed, skipped" -ForegroundColor Yellow; continue }
        $count = 0
        foreach ($pkg in $pkgs) {
            if (-not $pkg.InstallLocation) { continue }
            $exes = Get-ChildItem -Path $pkg.InstallLocation -Filter *.exe -File -Recurse -Depth 2 -ErrorAction SilentlyContinue
            foreach ($exe in $exes) { Add-BlockRule -Name $label -Program $exe.FullName; $count++ }
        }
        if ($count -eq 0) { Write-Host "  - $label : no executables found (folder may be access-restricted)" -ForegroundColor Yellow }
    }

    Write-Host "  [OK] Firewall rules configured" -ForegroundColor White
}
catch {
    Write-Host "  [X] ERROR configuring firewall rules: $_" -ForegroundColor Red
    $failed.Add('Firewall')
}
Write-Host ""

# ---------------------------------------------------------------------------
# [2/3] User rights assignment
# ---------------------------------------------------------------------------
Write-Host "[2/3] Configuring User Rights Assignment..." -ForegroundColor Green

$userRights = [ordered]@{
    SeNetworkLogonRight                = '*S-1-5-32-544'
    SeInteractiveLogonRight            = '*S-1-5-32-544,*S-1-5-32-545'
    SeBackupPrivilege                  = '*S-1-5-32-544'
    SeDenyNetworkLogonRight            = '*S-1-5-32-546,*S-1-5-113'
    SeDenyBatchLogonRight              = '*S-1-5-32-546'
    SeDenyServiceLogonRight            = '*S-1-5-32-546'
    SeDenyInteractiveLogonRight        = '*S-1-5-32-546'
    SeDenyRemoteInteractiveLogonRight  = '*S-1-5-32-546,*S-1-5-113'
    SeBatchLogonRight                  = '*S-1-5-32-544'
    # SeServiceLogonRight intentionally NOT touched: blanking it breaks services that run under named accounts.
    SeShutdownPrivilege                = '*S-1-5-32-544,*S-1-5-32-545'
}

try {
    Invoke-SeceditArea -Area 'USER_RIGHTS' -Edit {
        param($lines)
        foreach ($k in $userRights.Keys) {
            Set-InfValue -Lines $lines -Section 'Privilege Rights' -Key $k -Value $userRights[$k]
        }
    }
    Write-Host "  [OK] User Rights Assignment configured" -ForegroundColor White
}
catch {
    Write-Host "  [X] ERROR configuring User Rights Assignment: $_" -ForegroundColor Red
    $failed.Add('UserRights')
}
Write-Host ""

